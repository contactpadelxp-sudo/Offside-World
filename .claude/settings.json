{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm audit*)",
      "Bash(npm ls*)",
      "Bash(npx eslint*)",
      "Bash(npx tsc*)",
      "Bash(npx next*)",
      "Bash(node *)",

      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git remote*)",

      "Bash(python3 *)",
      "Bash(curl *)",
      "Bash(kill *)",

      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(sed*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(find*)",
      "Bash(wc*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(tr*)",
      "Bash(awk*)",
      "Bash(diff*)",
      "Bash(which*)",
      "Bash(file*)",
      "Bash(echo*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(touch*)",
      "Bash(for *)",
      "Bash(export *)",

      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__search_docs"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
